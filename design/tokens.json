{
  "name": "hito",
  "font": { "family": "'Plus Jakarta Sans', system-ui, sans-serif", "weights": [400, 500, 600, 700, 800] },
  "color": {
    "green": {
      "900": "#022C17", "800": "#04512A", "700": "#007A3D", "700-hover": "#00652F",
      "500": "#00A859", "300": "#5FD597", "200": "#B5D8C4", "100": "#C8ECD7", "50": "#E4F5EB"
    },
    "neutral": {
      "text": "#17201B", "text-soft": "#3C4741", "muted": "#58635D", "border": "#E1E6E3",
      "surface": "#EEF2F0", "bg": "#F6F8F7", "input-border": "#7F8A84", "disabled": "#C9D0CC", "gray-500": "#9AA49F"
    },
    "status": {
      "development": { "bg": "#2F6FC4", "ink": "#FFFFFF" },
      "qa":          { "bg": "#D9822B", "ink": "#17201B" },
      "production":  { "bg": "#00A859", "ink": "#022C17" },
      "delivered":   { "bg": "#04512A", "ink": "#FFFFFF" },
      "on_hold":     { "bg": "#58635D", "ink": "#FFFFFF" }
    },
    "task_state": {
      "pending":     { "bg": "#C9D0CC", "ink": "#17201B" },
      "in_progress": { "bg": "#D9822B", "ink": "#17201B" },
      "done":        { "bg": "#007A3D", "ink": "#FFFFFF" },
      "blocked":     { "bg": "#B42318", "ink": "#FFFFFF" }
    },
    "priority": {
      "high":   { "bg": "#FDECEA", "ink": "#B42318" },
      "medium": { "bg": "#FDF0E3", "ink": "#8A4A0B" },
      "low":    { "bg": "#EEF2F0", "ink": "#58635D" }
    },
    "health": {
      "late":     { "bg": "#FDECEA", "ink": "#B42318", "dot": "#B42318" },
      "at_risk":  { "bg": "#FDF0E3", "ink": "#8A4A0B", "dot": "#D9822B" },
      "on_track": { "bg": "#E4F5EB", "ink": "#00652F", "dot": "#00A859" },
      "on_hold":  { "bg": "#EEF2F0", "ink": "#58635D", "dot": "#7F8A84" }
    },
    "resource_kind": {
      "document": { "bg": "#E6F0FB", "ink": "#1D4F91" },
      "flow":     { "bg": "#E4F5EB", "ink": "#007A3D" },
      "code":     { "bg": "#EEF2F0", "ink": "#17201B" },
      "link":     { "bg": "#FDF0E3", "ink": "#8A4A0B" }
    },
    "change_kind": {
      "status": { "bg": "#FDF0E3", "ink": "#8A4A0B" },
      "date":   { "bg": "#FDECEA", "ink": "#B42318" },
      "task":   { "bg": "#E6F0FB", "ink": "#1D4F91" },
      "phase":  { "bg": "#E4F5EB", "ink": "#00652F" },
      "scope":  { "bg": "#EEF2F0", "ink": "#58635D" }
    },
    "current_phase": { "bg": "#FFFAF4", "border": "#D9822B" }
  },
  "radius": { "card": "14px", "dialog": "20px", "button": "10px", "input": "8px", "label": "6px", "pill": "999px" },
  "layout": { "maxContentWidth": "1376px", "pagePadding": "28px 32px", "topBarHeight": "56px", "minDesktop": "1280px" },
  "shadow": {
    "cardHover": "0 8px 24px rgba(2,44,23,.08)",
    "dialog": "0 24px 64px rgba(0,0,0,.3)",
    "overlay": "rgba(2,44,23,.55)"
  }
}
